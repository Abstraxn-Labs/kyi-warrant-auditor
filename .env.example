# Warrant API (used only to fetch the public key if PUBLIC_KEY_HEX is empty)
WARRANT_URL=https://api-warrant.abstraxn.com

# —— Public key (PUBLIC — safe to commit examples, never private keys) ——
# Same Ed25519 key verifies all receipts until Warrant rotates keys.
# A) Paste public_key_hex (recommended for offline audits):
#    curl -sS https://api-warrant.abstraxn.com/v1/warrant/keys/receipt
PUBLIC_KEY_HEX=

# B) Or let the local server fetch the key once at startup (optional API key if endpoint requires it):
# ABSTRAXN_API_KEY=

# Optional: path to a hex / JSON public key file
# PUBLIC_KEY_FILE=./public.key

# Demo server port (UI proxies /api here)
AUDITOR_PORT=3020

# On-chain checks (set ONCHAIN=0 to skip RPC)
ONCHAIN=1
WARRANT_CHAIN_ID=84532
WARRANT_RPC_URL=https://sepolia.base.org
# Per-chain overrides (optional):
# WARRANT_RPC_URL_80002=https://poly-amoy-testnet.api.pocket.network
# WARRANT_RPC_URL_84532=https://sepolia.base.org

# Contract addresses (CREATE2 — same across supported chains)
WARRANT_RECEIPT_LOG=0x65eDCae32a92eCCC47b7f0CBa06f2F924ce3A45E
WARRANT_MANDATE_REGISTRY=0x9f13744Cd7ca5b7851Aa21C9607617a83904A3b5

# Optional mandate check (both required if used)
# MANDATE_ID=mnd_sha256:…
# MANDATE_CONTENT_HASH=…
